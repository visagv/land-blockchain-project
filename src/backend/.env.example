# Copy this file to ".env" and fill in your own values.

# MongoDB connection string (local MongoDB or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/land-blockchain-db

# Any random long secret string - used to sign login tokens
JWT_SECRET=change_this_to_a_long_random_secret

# Server port
PORT=5000

# Paste one of the private keys Ganache shows when it starts
# (same one you put in blockchain/hardhat.config.js)
GANACHE_PRIVATE_KEY=PASTE_YOUR_GANACHE_PRIVATE_KEY_HERE
